#!/usr/bin/env python3
"""putio-statusd — read-only HTTP status for Drovie Downloader.

Serves what `putioctl status --json` reports, so Drovie (and the Drovie app
behind it) can show live download progress. Nothing here starts, stops or
touches a transfer.

Why a daemon at all, when the processor is a cron script: the progress state
changes between runs, every few seconds while a transfer moves, and there is
nothing long-lived to ask. This holds no state of its own — it reads the same
files putioctl reads — so it inherits the processor's crash-only property. Kill
it and launchd restarts it; nothing is lost, and downloads never notice.

THE ONE THING THAT MATTERS HERE
    A transfer in its copy phase is measured by stat'ing the destination on the
    SMB share, and free space runs df against the same share. Both sit in the
    kernel — uninterruptibly — when the NAS drops. If a request handler ever
    called putioctl directly, one dropped mount would wedge every request,
    Drovie's fetch would hang, and the Drovie app would hang behind it.

    So: a refresher thread owns the snapshot and handlers only ever serialize
    the last good one. On timeout the child's process group is killed and the
    process is *abandoned* rather than waited on, because waiting on something
    stuck in uninterruptible sleep is the wedge we are avoiding. Output goes to
    a temp file rather than a pipe, so an abandoned child leaks no reader thread.

Stdlib only, and 3.9-compatible: /usr/bin/python3 is the interpreter this box
guarantees, and taking no dependencies means there is no venv to break.
"""

import argparse
import errno
import json
import os
import signal
import subprocess
import sys
import tempfile
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

SCHEMA_FALLBACK = 1
START_MONOTONIC = time.monotonic()


def log(msg):
    sys.stderr.write("[statusd] %s\n" % msg)
    sys.stderr.flush()


class Probe(object):
    """Runs putioctl and hands back parsed JSON, or raises.

    Every call is bounded. A child that outlives its timeout is killed by
    process group — putioctl shells out further, and killing only the direct
    child would leave the grandchild holding the blocked stat.
    """

    def __init__(self, argv, timeout):
        self.argv = argv
        self.timeout = timeout
        self._abandoned = []

    def reap(self):
        """Poll abandoned children so they don't linger as zombies.

        Non-blocking on purpose: one of these may be unkillable for as long as
        the share stays dead, and this runs on the refresher thread.
        """
        still = []
        for p in self._abandoned:
            if p.poll() is None:
                still.append(p)
        self._abandoned = still

    def run(self):
        with tempfile.TemporaryFile() as out:
            proc = subprocess.Popen(
                self.argv,
                stdout=out,
                stderr=subprocess.DEVNULL,
                stdin=subprocess.DEVNULL,
                # Its own process group, so the kill below reaches whatever
                # putioctl spawned rather than just putioctl.
                start_new_session=True,
            )
            try:
                rc = proc.wait(timeout=self.timeout)
            except subprocess.TimeoutExpired:
                self._kill_group(proc)
                self._abandoned.append(proc)
                raise RuntimeError(
                    "putioctl exceeded %.1fs — the media share is most likely "
                    "unresponsive" % self.timeout
                )
            if rc != 0:
                raise RuntimeError("putioctl exited %d" % rc)
            out.seek(0)
            raw = out.read()

        if not raw.strip():
            raise RuntimeError("putioctl produced no output")
        try:
            return json.loads(raw.decode("utf-8", "replace"))
        except ValueError as exc:
            raise RuntimeError("putioctl output was not JSON: %s" % exc)

    @staticmethod
    def _kill_group(proc):
        try:
            os.killpg(os.getpgid(proc.pid), signal.SIGKILL)
        except OSError as exc:
            # ESRCH just means it exited in the gap; anything else is worth
            # knowing about but not worth dying over.
            if exc.errno != errno.ESRCH:
                log("could not kill process group %d: %s" % (proc.pid, exc))


class Snapshot(object):
    """The last good reading, plus why the most recent attempt failed."""

    def __init__(self):
        self._lock = threading.Lock()
        self._data = None
        self._at = None          # time.monotonic() of the last success
        self._error = None       # str, most recent failure
        self._successes = 0
        self._failures = 0

    def store(self, data):
        with self._lock:
            self._data = data
            self._at = time.monotonic()
            self._error = None
            self._successes += 1

    def fail(self, message):
        # Deliberately keeps the previous reading. A momentarily unreachable
        # share should age the data, not blank it — a caller can see both the
        # last known transfers and how stale they are, and decide for itself.
        with self._lock:
            self._error = message
            self._failures += 1

    def read(self):
        with self._lock:
            if self._data is None:
                return None, None, self._error
            return self._data, round(time.monotonic() - self._at, 1), self._error

    def health(self):
        with self._lock:
            age = None if self._at is None else round(time.monotonic() - self._at, 1)
            return {
                "ok": True,
                "uptime_seconds": round(time.monotonic() - START_MONOTONIC, 1),
                "last_success_age_seconds": age,
                "successes": self._successes,
                "failures": self._failures,
                "last_error": self._error,
            }


class Refresher(threading.Thread):
    """Polls putioctl on an interval. Never dies."""

    daemon = True

    def __init__(self, probe, snapshot, interval):
        threading.Thread.__init__(self, name="refresher")
        self.probe = probe
        self.snapshot = snapshot
        self.interval = interval
        self._stop = threading.Event()

    def stop(self):
        self._stop.set()

    def run(self):
        while not self._stop.is_set():
            try:
                self.probe.reap()
                self.snapshot.store(self.probe.run())
            except Exception as exc:  # noqa: BLE001 — a refresher that can die is useless
                self.snapshot.fail(str(exc))
            self._stop.wait(self.interval)


def make_handler(snapshot):
    class Handler(BaseHTTPRequestHandler):
        server_version = "putio-statusd"
        sys_version = ""
        protocol_version = "HTTP/1.1"
        # HTTP/1.1 means keep-alive, and ThreadingHTTPServer pins a thread per
        # connection, so a peer that opens one and then goes away — Drovie
        # SIGKILLed mid-request, a half-open socket — would park that thread for
        # the life of the daemon with nothing to reclaim it. handle_one_request
        # turns the resulting socket timeout into a closed connection.
        timeout = 30

        # Never touches the filesystem. Everything below is served out of the
        # in-memory snapshot the refresher maintains.
        def do_GET(self):  # noqa: N802 — BaseHTTPRequestHandler's spelling
            path = self.path.split("?", 1)[0].rstrip("/") or "/"
            if path == "/healthz":
                return self._send(200, snapshot.health())
            if path in ("/", "/status"):
                return self._snapshot_response(lambda d: d)
            if path == "/transfers":
                return self._snapshot_response(
                    lambda d: {
                        "schema": d.get("schema", SCHEMA_FALLBACK),
                        "state": d.get("state"),
                        "transfers": d.get("transfers", []),
                    }
                )
            return self._send(404, {"error": "not found", "paths": ["/status", "/transfers", "/healthz"]})

        def _snapshot_response(self, shape):
            data, stale, error = snapshot.read()
            if data is None:
                # Nothing has ever succeeded — say so rather than inventing an
                # empty but plausible-looking status.
                return self._send(503, {
                    "error": "no reading yet",
                    "detail": error or "the first refresh has not completed",
                })
            body = dict(shape(data))
            body["stale_seconds"] = stale
            # Present only when the latest attempt failed; the data above is
            # then the last good reading, not a current one.
            if error:
                body["source_error"] = error
            return self._send(200, body)

        def _send(self, code, payload):
            raw = json.dumps(payload, ensure_ascii=False, sort_keys=False).encode("utf-8")
            self.send_response(code)
            self.send_header("Content-Type", "application/json; charset=utf-8")
            self.send_header("Content-Length", str(len(raw)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            if getattr(self, "_head_only", False):
                return
            try:
                self.wfile.write(raw)
            except (BrokenPipeError, ConnectionResetError):
                pass  # client hung up mid-write; nothing to do and nothing wrong

        def do_HEAD(self):  # noqa: N802
            # Same status and headers as GET — Content-Length included, which
            # for HEAD describes what a GET *would* return — but no entity. A
            # correct client does not read a HEAD body, so writing one leaves
            # those bytes to be parsed as the next response on a keep-alive
            # connection, desyncing a pooled client.
            self._head_only = True
            self.do_GET()

        def log_message(self, fmt, *args):
            if self.server.verbose:
                log("%s %s" % (self.address_string(), fmt % args))

        def log_error(self, fmt, *args):
            log("%s %s" % (self.address_string(), fmt % args))

    return Handler


class Server(ThreadingHTTPServer):
    daemon_threads = True
    # A restart under launchd must not trip over its own TIME_WAIT sockets.
    allow_reuse_address = True

    def __init__(self, addr, handler, verbose):
        ThreadingHTTPServer.__init__(self, addr, handler)
        self.verbose = verbose


def main():
    ap = argparse.ArgumentParser(
        description="Read-only HTTP status for Drovie Downloader (the put.io downloader).",
    )
    ap.add_argument("--putioctl", default=os.path.expanduser("~/Scripts/putioctl"),
                    help="path to putioctl (default: %(default)s)")
    ap.add_argument("--script", default=None,
                    help="processor path to pass through as --script, so the daemon "
                         "and the CLI resolve the same config")
    # STATUSD_BIND / STATUSD_PORT exist for the container, where there are no
    # launchd ProgramArguments to edit and Drovie runs in a *different*
    # container: loopback there is unreachable from Drovie, so the image sets
    # STATUSD_BIND=0.0.0.0 and relies on the port not being published. On a
    # bare-metal host keep loopback — the endpoint has no auth of its own.
    ap.add_argument("--bind", default=os.environ.get("STATUSD_BIND") or "127.0.0.1",
                    help="address to listen on (default: %(default)s; env STATUSD_BIND). "
                         "Loopback unless Drovie runs elsewhere, because the "
                         "endpoint has no auth of its own")
    ap.add_argument("--port", type=int, default=int(os.environ.get("STATUSD_PORT") or 9494),
                    help="default: %(default)s; env STATUSD_PORT")
    ap.add_argument("--interval", type=float, default=2.0,
                    help="seconds between refreshes (default: %(default)s)")
    ap.add_argument("--timeout", type=float, default=10.0,
                    help="seconds before a putioctl call is killed and abandoned "
                         "(default: %(default)s)")
    ap.add_argument("--verbose", action="store_true", help="log every request")
    args = ap.parse_args()

    if not os.access(args.putioctl, os.X_OK):
        sys.exit("putioctl is not executable: %s" % args.putioctl)
    if args.interval <= 0:
        sys.exit("--interval must be positive")
    if args.timeout <= 0:
        sys.exit("--timeout must be positive")

    argv = [args.putioctl]
    if args.script:
        argv += ["--script", args.script]
    argv += ["status", "--json"]

    snapshot = Snapshot()

    # Bind before starting the refresher: if the address is taken there is no
    # point probing putioctl, and KeepAlive means launchd relaunches us every
    # ThrottleInterval for as long as the conflict lasts. An uncaught OSError
    # would put a ten-line traceback into the log on every one of those
    # attempts, in the directory whose growth the processor has a whole
    # rotate_log for.
    try:
        server = Server((args.bind, args.port), make_handler(snapshot), args.verbose)
    except OSError as exc:
        sys.exit("cannot bind %s:%d — %s" % (args.bind, args.port, exc))

    refresher = Refresher(Probe(argv, args.timeout), snapshot, args.interval)
    refresher.start()

    def shutdown(signum, _frame):
        log("signal %d — shutting down" % signum)
        refresher.stop()
        threading.Thread(target=server.shutdown, daemon=True).start()

    signal.signal(signal.SIGTERM, shutdown)
    signal.signal(signal.SIGINT, shutdown)

    log("serving http://%s:%d — refresh %.1fs, timeout %.1fs, via %s"
        % (args.bind, args.port, args.interval, args.timeout, args.putioctl))
    # Named explicitly: the shim picks this from the config, so the log is the
    # only place that records which interpreter actually won.
    log("python %s at %s" % (sys.version.split()[0], sys.executable))
    try:
        server.serve_forever()
    finally:
        server.server_close()
        log("stopped")


if __name__ == "__main__":
    main()
